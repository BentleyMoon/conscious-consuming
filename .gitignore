# The Open Values Standard — .gitignore
# This is a static, no-build project: source IS the site. We ignore only OS/editor
# cruft, Python caches, and the regenerable deployable. Source data (content/lenses,
# app/data, pipeline/raw, pipeline/prices) is intentionally COMMITTED — keeping the
# inputs makes the build reproducible, which the data licence (ODbL) and DPG review value.

# ── OS cruft ───────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editors / IDEs ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── Python (pipeline + app/serve.py) ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Node (build_cards.js / build_og helpers, if a toolchain is added) ────────────
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Logs / temp ──────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak

# ── Local-only (not part of the public standard) ─────────────────────────────────
# local reference copy of a published paper (copyrighted; cite, don't ship)
kiz.txt
# the private-name and private-path lists scripts/mirror-public.py reads before publishing; they
# name what must not be published, so they are never tracked (see the comments in that script)
.mirror-private-words
.mirror-private-paths

# ── Built, regenerable deployable ────────────────────────────────────────────────
# Rebuild any time with:  python pipeline/build_site.py
# (Un-ignore this if you choose to deploy the repo directly via GitHub Pages.)
dist/
# A 55 MB ontology study, kept out of the repo: it is working material, not a product input.
ontologystudy/
