{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/node-preview-matrix-v0.1.schema.json",
  "title": "Open Values Node Preview Matrix v0.1",
  "description": "Private-preview and handoff-drain QA matrix for app-owned node and Ask integration.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "built", "source", "purpose", "appLaneNote", "status", "h4DrainableFromDataAlone", "groups", "runContract", "scenarios", "totals"],
  "properties": {
    "format": { "const": "ovs-node-preview-matrix" },
    "version": { "$ref": "#/$defs/version" },
    "built": { "$ref": "#/$defs/date" },
    "source": { "$ref": "#/$defs/source" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "appLaneNote": { "$ref": "#/$defs/nonEmptyString" },
    "status": { "const": "pending-app-integration" },
    "h4DrainableFromDataAlone": { "const": false },
    "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "runContract": { "$ref": "#/$defs/runContract" },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
    "totals": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "group", "title", "owner", "sourceFiles", "steps", "acceptanceCriteria", "mustNot"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "group": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "const": "app/design" },
        "sourceFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "mustNot": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "runContract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["purpose", "status", "h4DrainableFromDataAlone", "namedConsumer", "drainRule", "evidenceRequired", "runOrder", "exitCriteria", "coverage"],
      "properties": {
        "purpose": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "const": "pending-app-integration" },
        "h4DrainableFromDataAlone": { "const": false },
        "namedConsumer": { "$ref": "#/$defs/nonEmptyString" },
        "drainRule": { "$ref": "#/$defs/nonEmptyString" },
        "evidenceRequired": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "runOrder": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/runStep" } },
        "exitCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "coverage": { "type": "object", "minProperties": 1 }
      }
    },
    "runStep": {
      "type": "object",
      "additionalProperties": true,
      "required": ["step", "group", "scenarioIds", "passWhen", "mustNot"],
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "group": { "$ref": "#/$defs/nonEmptyString" },
        "scenarioIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "passWhen": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "mustNot": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    }
  }
}
