{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/avoid-token-index-v0.1.schema.json",
  "title": "Open Values Avoid Token Index v0.1",
  "description": "A compact generated export of avoid-line token families for browser-extension and line tooling.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "built",
    "source",
    "purpose",
    "matching",
    "families",
    "stats"
  ],
  "properties": {
    "format": {
      "const": "ovs-avoid-token-index"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "built": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "$ref": "#/$defs/sourceList"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "matching": {
      "$ref": "#/$defs/matching"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "stats": {
      "$ref": "#/$defs/stats"
    }
  },
  "$defs": {
    "sourceList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "normalization",
        "boundary",
        "appLaneNote"
      ],
      "properties": {
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "appLaneNote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "line",
        "label",
        "entity",
        "tokens",
        "tokenCount",
        "source",
        "sourceLineBrands",
        "sourceCompanyBrands"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^avoid:[a-z0-9-]+$"
        },
        "line": {
          "type": "string",
          "pattern": "^ovs:line/avoid:[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?: [a-z0-9]+)*$"
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?: [a-z0-9]+)*$"
          }
        },
        "tokenCount": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sourceLineBrands": {
          "type": "integer",
          "minimum": 0
        },
        "sourceCompanyBrands": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "required": [
        "families",
        "tokens",
        "uniqueTokens",
        "bytes"
      ]
    }
  }
}
