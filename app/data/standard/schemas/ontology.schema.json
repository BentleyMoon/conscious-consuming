{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/ontology-v0.4.schema.json",
  "title": "Open Values Ontology v0.4",
  "description": "A needs-first taxonomy with a backward-compatible life-domain index for live and growing category nodes.",
  "type": "object",
  "required": [
    "version",
    "types",
    "needs",
    "domains"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "type": "string"
    },
    "types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/type"
      },
      "uniqueItems": true
    },
    "needs": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/need"
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domain"
      }
    }
  },
  "$defs": {
    "type": {
      "type": "string",
      "enum": [
        "Products",
        "Services",
        "Media",
        "Organizations",
        "Initiatives"
      ]
    },
    "need": {
      "type": "object",
      "required": [
        "id",
        "label",
        "reads"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "nourish",
            "care",
            "keep-a-home",
            "connect",
            "move",
            "learn",
            "give-and-act",
            "protect"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "reads": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        }
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "label",
        "categories"
      ],
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          }
        }
      }
    },
    "category": {
      "type": "object",
      "required": [
        "label",
        "type",
        "need"
      ],
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "cid": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "$ref": "#/$defs/type"
        },
        "need": {
          "type": "string",
          "enum": [
            "nourish",
            "care",
            "keep-a-home",
            "connect",
            "move",
            "learn",
            "give-and-act",
            "protect"
          ]
        },
        "group": {
          "type": "string"
        },
        "facet": {
          "type": "string"
        }
      }
    }
  }
}
