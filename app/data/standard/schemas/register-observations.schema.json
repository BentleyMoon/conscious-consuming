{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/register-observations-v1.schema.json",
  "title": "Open Values Register Observations",
  "description": "Parser output containing only structured, traceable observations from one verified register snapshot.",
  "type": "object",
  "required": ["format", "version", "registerId", "snapshot", "parser", "targets", "observations"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "open-values-register-observations" },
    "version": { "const": "1.0.0" },
    "registerId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "snapshot": {
      "type": "object",
      "required": ["manifest", "snapshotId", "payloadSha256"],
      "additionalProperties": false,
      "properties": {
        "manifest": { "type": "string", "pattern": "^pipeline/registers/raw/[^/]+/[^/]+\\.snapshot\\.json$" },
        "snapshotId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{12}$" },
        "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "parser": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/.+$" }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "object",
      "required": ["scheme", "value"],
      "additionalProperties": false,
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "record": {
      "type": "object",
      "required": ["id", "pointer"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "pattern": "^(#|/|line:|row:)" }
      }
    },
    "claim": {
      "type": "object",
      "required": ["label", "value", "recordIds"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "integer", "boolean"] },
        "unit": { "type": "string", "minLength": 1 },
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "observation": {
      "type": "object",
      "required": ["registerIdentifier", "outcome", "searchTerms", "records", "claims"],
      "additionalProperties": false,
      "properties": {
        "registerIdentifier": { "$ref": "#/$defs/identifier" },
        "outcome": { "enum": ["records-found", "no-matching-record"] },
        "searchTerms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "records-found" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "records": { "minItems": 1 },
              "claims": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "no-matching-record" } }, "required": ["outcome"] },
          "then": {
            "properties": {
              "records": { "maxItems": 0 },
              "claims": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
