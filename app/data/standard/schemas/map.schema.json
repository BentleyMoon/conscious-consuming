{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/map-v1.schema.json",
  "title": "Conscious Consuming Map v1",
  "description": "The whole map published for a spatial view: every decision the catalogue names, in four levels, each carrying the state the taxonomy gave it. A built decision carries the id of its dataset; open, held and refused decisions carry no route because there is nothing yet to route to. Distinct from the ontology, which navigates only what can be shown today, and from the taxonomy, which is the authored source this is compiled from.",
  "type": "object",
  "required": ["format", "version", "built", "purpose", "consumer", "source", "states", "totals", "realms"],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "open-values-map" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "built": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "purpose": { "type": "string", "minLength": 1 },
    "consumer": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "states": {
      "type": "object",
      "description": "Every state a decision can be published in, described in the words a reader would meet.",
      "required": ["built", "open", "held", "refused"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "totals": {
      "type": "object",
      "required": ["realms", "fields", "families", "decisions", "built", "open", "held", "refused"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "realms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "need": { "type": "string", "minLength": 1 },
          "edge": { "type": "string" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "families"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "label": { "type": "string", "minLength": 1 },
                "families": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "decisions"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                      "label": { "type": "string", "minLength": 1 },
                      "decisions": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": ["id", "label", "state", "need"],
                          "additionalProperties": false,
                          "properties": {
                            "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                            "label": { "type": "string", "minLength": 1 },
                            "state": { "enum": ["built", "open", "held", "refused"] },
                            "need": { "type": "string", "minLength": 1 },
                            "cid": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
