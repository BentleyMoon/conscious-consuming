{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/register-evidence-bundle-v1.schema.json",
  "title": "Open Values Register Evidence Bundle",
  "description": "Deterministically generated lens-ready provenance from a verified snapshot, reviewed mappings, and traceable observations.",
  "type": "object",
  "required": ["format", "version", "registerId", "criterion", "snapshot", "generatedFrom", "counts", "reviewRequirement", "entries"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "open-values-register-evidence-bundle" },
    "version": { "const": "1.0.0" },
    "registerId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "criterion": { "type": "string", "minLength": 1 },
    "snapshot": {
      "type": "object",
      "required": ["snapshotId", "capturedAt", "queryUrl", "scope", "payloadSha256"],
      "additionalProperties": false,
      "properties": {
        "snapshotId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{12}$" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "queryUrl": { "type": "string", "pattern": "^https?://" },
        "scope": { "type": "string", "minLength": 1 },
        "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "generatedFrom": {
      "type": "object",
      "required": ["snapshotManifest", "snapshotManifestSha256", "mapping", "mappingSha256", "observations", "observationsSha256", "coverageMatrixSha256", "generatorVersion"],
      "additionalProperties": false,
      "properties": {
        "snapshotManifest": { "type": "string", "minLength": 1 },
        "snapshotManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "mapping": { "type": "string", "minLength": 1 },
        "mappingSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "observations": { "type": "string", "minLength": 1 },
        "observationsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "coverageMatrixSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "generatorVersion": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" }
      }
    },
    "counts": {
      "type": "object",
      "required": ["matchedMappings", "recordsFound", "scopedAbsences", "entries"],
      "additionalProperties": false,
      "properties": {
        "matchedMappings": { "type": "integer", "minimum": 0 },
        "recordsFound": { "type": "integer", "minimum": 0 },
        "scopedAbsences": { "type": "integer", "minimum": 0 },
        "entries": { "type": "integer", "minimum": 0 }
      }
    },
    "reviewRequirement": {
      "type": "object",
      "required": ["method", "sampleSize", "entryIds"],
      "additionalProperties": false,
      "properties": {
        "method": { "const": "lowest-sha256-of-bundle-inputs-and-entry-id" },
        "sampleSize": { "type": "integer", "minimum": 0, "maximum": 10 },
        "entryIds": { "type": "array", "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["entryId", "cid", "entityCode", "entityName", "entityIdentitySha256", "legalName", "registerIdentifier", "mappingReview", "outcome", "searchTerms", "recordTrace", "provenance"],
      "additionalProperties": false,
      "properties": {
        "entryId": { "type": "string", "minLength": 1 },
        "cid": { "type": "string", "minLength": 1 },
        "entityCode": { "type": "string", "minLength": 1 },
        "entityName": { "type": "string", "minLength": 1 },
        "entityIdentitySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "legalName": { "type": "string", "minLength": 1 },
        "registerIdentifier": { "type": "object", "required": ["scheme", "value"], "additionalProperties": false, "properties": { "scheme": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 } } },
        "mappingReview": { "type": "object", "required": ["by", "on"], "additionalProperties": false, "properties": { "by": { "type": "string", "minLength": 1 }, "on": { "type": "string", "format": "date" } } },
        "outcome": { "enum": ["records-found", "no-matching-record"] },
        "searchTerms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "recordTrace": { "type": "array", "items": { "type": "object", "required": ["id", "pointer"], "additionalProperties": false, "properties": { "id": { "type": "string", "minLength": 1 }, "pointer": { "type": "string", "minLength": 1 } } } },
        "provenance": { "type": "object", "required": ["note", "source", "asof"], "additionalProperties": false, "properties": { "note": { "type": "string", "minLength": 1 }, "source": { "type": "string", "pattern": "^https?://" }, "asof": { "type": "string", "pattern": "^\\d{4}$" } } }
      }
    }
  }
}
