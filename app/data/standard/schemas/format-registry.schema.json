{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/format-registry-v1.schema.json",
  "title": "Open Values Format Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "standard",
    "standardVersion",
    "updated",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "open-values-format-registry"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "standard": {
      "const": "open-values-standard"
    },
    "standardVersion": {
      "$ref": "#/$defs/semver"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "pathList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/path"
      },
      "uniqueItems": true
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "explicit-format",
            "legacy-shape",
            "schema",
            "html-jsonld",
            "test-fixture"
          ]
        },
        "format": {
          "type": "string",
          "pattern": "^(open-values|ovs)-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "pathPattern": {
          "$ref": "#/$defs/path"
        },
        "pathPatterns": {
          "$ref": "#/$defs/pathList"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acceptsLegacyVersion": {
          "type": "boolean"
        },
        "acceptsBareVersion": {
          "type": "boolean"
        },
        "breakingChangePolicy": {
          "type": "string"
        },
        "migration": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "kind",
        "purpose",
        "marker",
        "schema",
        "sourceOfTruth",
        "generatedOutputs",
        "builders",
        "audits",
        "ownerLane",
        "runtimeConsumers",
        "compatibility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(open-values|ovs)-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "declaredVersion": {
          "type": "string"
        },
        "status": {
          "enum": [
            "stable",
            "draft",
            "experimental",
            "dev-contract",
            "legacy"
          ]
        },
        "kind": {
          "enum": [
            "source",
            "generated",
            "fixture",
            "distribution",
            "internal"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "marker": {
          "$ref": "#/$defs/marker"
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "schemaNote": {
          "type": "string"
        },
        "sourceOfTruth": {
          "$ref": "#/$defs/pathList"
        },
        "generatedOutputs": {
          "$ref": "#/$defs/pathList"
        },
        "builders": {
          "$ref": "#/$defs/pathList"
        },
        "audits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ownerLane": {
          "enum": [
            "codex-data",
            "claude-app",
            "generated",
            "external",
            "shared"
          ]
        },
        "runtimeConsumers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "compatibility": {
          "$ref": "#/$defs/compatibility"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(open-values|ovs)-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
