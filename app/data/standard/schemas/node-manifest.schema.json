{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/node-manifest-v0.1.schema.json",
  "title": "Open Values Node Manifest v0.1",
  "description": "A generated manifest for node-index files, load order, integrity hashes, and runtime loading hints.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "built",
    "source",
    "appLaneNote",
    "integrity",
    "loadOrder",
    "loaderPlan",
    "indexes",
    "totals"
  ],
  "properties": {
    "format": {
      "const": "ovs-node-manifest"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "built": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "appLaneNote": {
      "type": "string",
      "minLength": 1
    },
    "integrity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "algorithm",
        "scope"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "loadOrder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+\\.json$"
      }
    },
    "indexes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/index"
      }
    },
    "loaderPlan": {
      "$ref": "#/$defs/loaderPlan"
    },
    "totals": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "$defs": {
    "index": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "file",
        "format",
        "version",
        "built",
        "bytes",
        "sha256",
        "loadHint"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.json$"
        },
        "format": {
          "type": "string",
          "pattern": "^(open-values|ovs)-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
        },
        "built": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "loadHint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "loaderPlan": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "purpose",
        "source",
        "integrity",
        "stages",
        "totals"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "integrity": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "algorithm",
            "cacheKey",
            "validate",
            "retry",
            "fallback"
          ],
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "cacheKey": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "validate": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "retry": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "fallback": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/loaderPlanStage"
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "loaderPlanStage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "step",
        "id",
        "label",
        "loadHint",
        "runtime",
        "trigger",
        "failureMode",
        "files"
      ],
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "loadHint": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "runtime": {
          "type": "boolean"
        },
        "trigger": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "failureMode": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/loaderPlanFile"
          }
        }
      }
    },
    "loaderPlanFile": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "file",
        "type",
        "loadHint",
        "cacheKey"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.json$"
        },
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "loadHint": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cacheKey": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrity": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    }
  }
}
