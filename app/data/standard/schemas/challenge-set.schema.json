{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/challenge-set-v0.1.schema.json",
  "title": "Open Values Challenge Set v0.1",
  "description": "Algorithmic anti-echo-chamber fixtures, contrary tags, and instance challenge defaults.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "standard", "updated", "purpose", "principles", "algorithms", "instances", "cases", "contraryTags"],
  "properties": {
    "format": { "const": "open-values-challenge-set" },
    "version": { "type": "string", "pattern": "^0\\.1\\.0(?:[-+].*)?$" },
    "standard": { "const": "open-values-standard" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "principles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "algorithms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/algorithm" } },
    "instances": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/instance" } },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } },
    "contraryTags": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contraryTag" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "source", "asof"],
      "properties": {
        "note": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "type": "string", "pattern": "^https?://" },
        "asof": { "type": "string", "pattern": "^(19|20)\\d{2}$" }
      }
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 5
      }
    },
    "algorithm": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "summary", "inputs", "outputs", "mustNot"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "mustNot": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "role", "challengeDefault", "surfaces"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "$ref": "#/$defs/nonEmptyString" },
        "challengeDefault": { "enum": ["available", "prominent", "primary"] },
        "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": true,
      "required": ["label", "weights", "expectedTop"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "weights": { "$ref": "#/$defs/weights" },
        "expectedTop": { "$ref": "#/$defs/slug" },
        "sourceTag": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "steelman": {
      "type": "object",
      "additionalProperties": true,
      "required": ["forEntity", "axis", "sourceTag", "framing"],
      "properties": {
        "forEntity": { "$ref": "#/$defs/slug" },
        "axis": { "$ref": "#/$defs/nonEmptyString" },
        "sourceTag": { "$ref": "#/$defs/nonEmptyString" },
        "framing": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "category", "label", "reads", "userView", "oppositeView", "steelman"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "category": { "$ref": "#/$defs/slug" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "reads": { "type": "string", "minLength": 24, "maxLength": 140 },
        "userView": { "$ref": "#/$defs/view" },
        "oppositeView": { "$ref": "#/$defs/view" },
        "steelman": { "$ref": "#/$defs/steelman" }
      }
    },
    "contraryTag": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "category", "entity", "axis", "polarity", "score", "summary", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "category": { "$ref": "#/$defs/slug" },
        "entity": { "$ref": "#/$defs/slug" },
        "axis": { "$ref": "#/$defs/nonEmptyString" },
        "polarity": { "enum": ["steelman-weakness", "opposite-view-strength"] },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/source" }
      }
    }
  }
}
