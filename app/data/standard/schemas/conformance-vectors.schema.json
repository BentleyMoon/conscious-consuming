{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/conformance-vectors-v0.1.schema.json",
  "title": "Open Values Conformance Vectors v0.1",
  "description": "Known-good and known-bad examples for standard conformance audits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "standard",
    "standardVersion",
    "updated",
    "vectors"
  ],
  "properties": {
    "format": {
      "const": "open-values-conformance-vectors"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "standard": {
      "const": "open-values-standard"
    },
    "standardVersion": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": {
      "type": "string"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "formatUnderTest",
        "expect",
        "reason",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "formatUnderTest": {
          "type": "string",
          "pattern": "^(open-values|ovs)-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "expect": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "value": true
      }
    }
  }
}
