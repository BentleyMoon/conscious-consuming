{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/asks-offers-index-v0.1.schema.json",
  "title": "Open Values Asks/Offers Index v0.1",
  "description": "Generated board-ready index for file-based asks and offers.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "standard", "built", "purpose", "generatedFrom", "publication", "counts", "sections", "filters", "principles", "items"],
  "properties": {
    "format": { "const": "open-values-asks-offers-index" },
    "version": { "type": "string", "pattern": "^0\\.1\\.0(?:[-+].*)?$" },
    "standard": { "const": "open-values-standard" },
    "built": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "generatedFrom": { "$ref": "#/$defs/generatedFrom" },
    "publication": { "$ref": "#/$defs/publication" },
    "counts": { "$ref": "#/$defs/counts" },
    "sections": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/section" } },
    "filters": { "$ref": "#/$defs/filters" },
    "principles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "region": { "enum": ["US", "UK", "EU", "global"] },
    "universalValue": { "enum": ["planet", "people", "openness", "access", "wellbeing", "autonomy", "animals", "community", "quality", "joy"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note", "source", "asof"],
      "properties": {
        "note": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "type": "string", "pattern": "^https?://" },
        "asof": { "type": "string", "pattern": "^(19|20)\\d{2}$" }
      }
    },
    "generatedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "updated", "sha256"],
      "properties": {
        "path": { "const": "content/asks-offers.json" },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "storage", "relay", "identity", "liveDatabase", "privacy"],
      "properties": {
        "status": { "enum": ["format-seed", "active", "archived"] },
        "storage": { "$ref": "#/$defs/nonEmptyString" },
        "relay": { "$ref": "#/$defs/nonEmptyString" },
        "identity": { "$ref": "#/$defs/nonEmptyString" },
        "liveDatabase": { "const": false },
        "privacy": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "asks", "offers", "templates", "live", "categories", "guides", "initiatives", "values", "regions"],
      "properties": {
        "items": { "type": "integer", "minimum": 1 },
        "asks": { "type": "integer", "minimum": 0 },
        "offers": { "type": "integer", "minimum": 0 },
        "templates": { "type": "integer", "minimum": 0 },
        "live": { "type": "integer", "const": 0 },
        "categories": { "type": "integer", "minimum": 0 },
        "guides": { "type": "integer", "minimum": 0 },
        "initiatives": { "type": "integer", "minimum": 0 },
        "values": { "type": "integer", "minimum": 0 },
        "regions": { "type": "integer", "minimum": 0 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "count"],
      "properties": {
        "id": { "enum": ["asks", "offers"] },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["ask", "offer"] },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "regions", "categories", "guides", "initiatives"],
      "properties": {
        "values": { "type": "array", "items": { "$ref": "#/$defs/universalValue" } },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "guides": { "type": "array", "items": { "$ref": "#/$defs/slug" } },
        "initiatives": { "type": "array", "items": { "$ref": "#/$defs/slug" } }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["Products", "Services", "Media", "Organizations", "Initiatives"] },
        "domain": { "$ref": "#/$defs/nonEmptyString" },
        "group": { "$ref": "#/$defs/nonEmptyString" },
        "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
        "n": { "type": "integer", "minimum": 0 }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "path", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "path": { "type": "string", "pattern": "^content/guides/[a-z0-9-]+\\.md$" },
        "hash": { "type": "string", "pattern": "^#guide/[a-z0-9-]+$" }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "name", "legitimacy", "actPath"],
      "properties": {
        "code": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "brand": { "$ref": "#/$defs/nonEmptyString" },
        "focuses": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "legitimacy": { "$ref": "#/$defs/legitimacy" },
        "actPath": { "$ref": "#/$defs/actPath" },
        "scoreSignals": {
          "type": "object",
          "additionalProperties": true
        },
        "links": { "type": "array" }
      }
    },
    "related": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "guides", "initiatives"],
      "properties": {
        "categories": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/category" } },
        "guides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/guide" } },
        "initiatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/initiative" } }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "listLabel", "items"],
      "properties": {
        "label": { "enum": ["Ask", "Offer"] },
        "listLabel": { "enum": ["Needs", "Offers"] },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "legitimacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "source"],
      "properties": {
        "line": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "actPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": { "enum": ["url", "plain"] },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "type": "string", "pattern": "^https?://" },
        "instruction": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "url" } } },
          "then": { "required": ["url"] }
        },
        {
          "if": { "properties": { "kind": { "const": "plain" } } },
          "then": { "required": ["instruction"] }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "status", "title", "summary", "prompt", "audience", "values", "regions", "action", "related", "receipts", "limits"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "kind": { "enum": ["ask", "offer"] },
        "status": { "enum": ["template", "seed", "live", "archived"] },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "prompt": { "$ref": "#/$defs/nonEmptyString" },
        "audience": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/universalValue" } },
        "regions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/region" } },
        "action": { "$ref": "#/$defs/action" },
        "related": { "$ref": "#/$defs/related" },
        "receipts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "limits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    }
  }
}
