{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/ask-index-v0.1.schema.json",
  "title": "Open Values Ask Index v0.1",
  "description": "A generated full Ask search index mapping tokens and aliases to Open Values targets.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "built",
    "source",
    "loadHint",
    "budget",
    "shards",
    "tokens",
    "aliases",
    "stats"
  ],
  "properties": {
    "format": {
      "const": "ovs-ask-index"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "built": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "$ref": "#/$defs/sourceList"
    },
    "loadHint": {
      "const": "lazy-product-search"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "shards": {
      "$ref": "#/$defs/shards"
    },
    "tokens": {
      "$ref": "#/$defs/tokenMap"
    },
    "aliases": {
      "$ref": "#/$defs/aliasMap"
    },
    "stats": {
      "$ref": "#/$defs/stats"
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^ovs:[a-z0-9-]+/[A-Za-z0-9._:-]+(?:-[A-Za-z0-9._:-]+)*$"
    },
    "sourceList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": true,
      "required": ["maxBytes", "currentBytes", "withinBudget", "measurement", "actionWhenExceeded"],
      "properties": {
        "maxBytes": {
          "const": 6000000
        },
        "currentBytes": {
          "type": "integer",
          "minimum": 1
        },
        "withinBudget": {
          "type": "boolean"
        },
        "measurement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "actionWhenExceeded": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "shards": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "count", "files", "hint"],
      "properties": {
        "status": {
          "enum": ["not-needed", "required"]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "hint": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "tokenMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/nodeId"
        }
      }
    },
    "aliasMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nodeId"
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
