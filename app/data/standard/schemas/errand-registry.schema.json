{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/errand-registry-v0.1.schema.json",
  "title": "Open Values Errand Registry v0.1",
  "description": "Structured task prompts that map a real-life errand to categories, picks, copy, and optional tradeoff axes.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "updated",
    "errands"
  ],
  "properties": {
    "format": {
      "const": "ovs-errand-registry"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "errands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/errand"
      }
    }
  },
  "$defs": {
    "errand": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "label",
        "aliases",
        "reads",
        "output",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ovs:errand/[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reads": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "enum": [
            "list"
          ]
        },
        "tradeoff": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "cat",
        "pick",
        "note"
      ],
      "properties": {
        "cat": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "pick": {
          "enum": [
            "one",
            "several"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
