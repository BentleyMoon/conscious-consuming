{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/presentation-source-index-v1.0.schema.json",
  "title": "Open Values Presentation Source Index v1.0",
  "description": "Stable source identities and reverse claim links used by accepted presentation routes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "updated", "scope", "records"],
  "properties": {
    "format": {"const": "open-values-presentation-source-index"},
    "version": {"const": "1.0.0"},
    "updated": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "scope": {"type": "string", "minLength": 1},
    "records": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/sourceRecord"}}
  },
  "$defs": {
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "sourceType", "published", "reviewed", "url", "scope", "method", "limits", "supportedClaims"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "sourceType": {"type": "string", "minLength": 1},
        "published": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "reviewed": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "url": {"type": "string", "pattern": "^https://"},
        "scope": {"type": "string", "minLength": 1},
        "method": {"type": ["string", "null"]},
        "limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "supportedClaims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "entry", "criterion"],
      "properties": {
        "category": {"type": "string", "minLength": 1},
        "entry": {"type": "string", "minLength": 1},
        "criterion": {"type": "string", "minLength": 1}
      }
    }
  }
}
