{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/node-index-v0.1.schema.json",
  "title": "Open Values Node Index v0.1",
  "description": "A generated index of browsable/searchable Open Values nodes such as brands, companies, tags, errands, and samples.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "built",
    "nodes"
  ],
  "properties": {
    "format": {
      "const": "ovs-node-index"
    },
    "type": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "built": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "minItems": {
      "type": "integer",
      "minimum": 1
    },
    "source": {
      "type": [
        "string",
        "array"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "longTail": {
      "type": "integer",
      "minimum": 0
    },
    "longTailItems": {
      "type": "integer",
      "minimum": 0
    },
    "descriptorItems": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^ovs:[a-z0-9-]+/[A-Za-z0-9._:-]+(?:-[A-Za-z0-9._:-]+)*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "ownedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "top": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topPick"
          }
        },
        "reads": {
          "type": "string"
        },
        "brands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "brandNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ownershipSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownershipSource"
          }
        },
        "kind": {
          "type": "string"
        },
        "receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "topPick": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "cat",
        "code",
        "name"
      ],
      "properties": {
        "cat": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "ownershipSource": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "from",
        "brandName",
        "source",
        "asof"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nodeId"
        },
        "brand": {
          "type": [
            "string",
            "null"
          ]
        },
        "brandName": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "asof": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
