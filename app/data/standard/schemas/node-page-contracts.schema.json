{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/node-page-contracts-v0.1.schema.json",
  "title": "Open Values Node Page Contracts v0.1",
  "description": "Route and page contract data for generated node, category, guide, and item pages.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "built", "source", "purpose", "appLaneNote", "contracts", "totals"],
  "properties": {
    "format": { "const": "ovs-node-page-contracts" },
    "version": { "$ref": "#/$defs/version" },
    "built": { "$ref": "#/$defs/date" },
    "source": { "$ref": "#/$defs/source" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "appLaneNote": { "$ref": "#/$defs/nonEmptyString" },
    "contracts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contract" } },
    "totals": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "ovsId": { "type": "string", "pattern": "^ovs:[^\\s/]+/.+$" },
    "routeHash": { "type": "string", "pattern": "^#" },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/ovsId" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "hash": { "$ref": "#/$defs/routeHash" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "routePattern", "source", "requiredFields", "sections", "examples"],
      "properties": {
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "routePattern": { "$ref": "#/$defs/routeHash" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "requiredFields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "optionalFields": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/example" } }
      }
    }
  }
}
