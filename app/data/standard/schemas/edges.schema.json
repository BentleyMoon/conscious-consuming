{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/edges-v0.1.schema.json",
  "title": "Open Values Edges v0.1",
  "description": "A relationship graph for ownership, alternatives, and other sourced relationships between Open Values nodes.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "edges"
  ],
  "properties": {
    "format": {
      "const": "open-values-edges"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "note": {
      "type": "string"
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^ovs:[a-z0-9-]+/[A-Za-z0-9._:-]+(?:-[A-Za-z0-9._:-]+)*$"
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "from",
        "rel",
        "to",
        "source",
        "asof"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nodeId"
        },
        "rel": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "to": {
          "$ref": "#/$defs/nodeId"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "asof": {
          "type": "string",
          "pattern": "^(19|20)\\d{2}(?:-\\d{2}-\\d{2})?$"
        }
      }
    }
  }
}
