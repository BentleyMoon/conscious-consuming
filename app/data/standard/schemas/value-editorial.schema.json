{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/value-editorial-v0.4.schema.json",
  "title": "Open Values Value Editorial v0.4",
  "description": "Claim-level explanatory copy and receipts for value pages, with evidence classification and missing-editorial state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "updated", "state", "purpose", "renderRule", "requiredValues", "pilotValues", "entries"],
  "properties": {
    "format": { "const": "open-values-value-editorial" },
    "version": { "type": "string", "pattern": "^0\\.4\\.0(?:[-+].*)?$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "state": { "const": "environmental-durability-batch" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "renderRule": { "$ref": "#/$defs/nonEmptyString" },
    "requiredValues": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "pilotValues": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "entries": {
      "type": "object",
      "minProperties": 15,
      "maxProperties": 15,
      "additionalProperties": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sourceLabel", "source", "asOf"],
      "properties": {
        "text": { "type": "string", "minLength": 40, "maxLength": 520 },
        "sourceLabel": { "type": "string", "minLength": 5 },
        "source": { "type": "string", "pattern": "^https://" },
        "asOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "heading", "claims"],
      "properties": {
        "id": { "enum": ["requires", "evidence", "checked-by", "limits", "scoring"] },
        "heading": { "type": "string", "minLength": 8 },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/claim" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "kind", "classification", "status", "summary", "sections"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["certified", "assessed"] },
        "classification": { "enum": ["certification-scheme", "assessed-value", "label-family", "ingredient-analysis", "mixed-methods"] },
        "status": { "const": "ready-for-founder-review" },
        "summary": { "type": "string", "minLength": 80, "maxLength": 300 },
        "sections": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/section" }
        }
      }
    }
  }
}
