{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/node-route-fixtures-v0.1.schema.json",
  "title": "Open Values Node Route Fixtures v0.1",
  "description": "Golden positive route parser fixtures for node and content page routes.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "built", "source", "purpose", "appLaneNote", "parserRules", "cases", "totals"],
  "properties": {
    "format": { "const": "ovs-node-route-fixtures" },
    "version": { "$ref": "#/$defs/version" },
    "built": { "$ref": "#/$defs/date" },
    "source": { "$ref": "#/$defs/source" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "appLaneNote": { "$ref": "#/$defs/nonEmptyString" },
    "parserRules": { "type": "object", "minProperties": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/routeCase" } },
    "totals": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "ovsId": { "type": "string", "pattern": "^ovs:[^\\s/]+/.+$" },
    "routeHash": { "type": "string", "pattern": "^#" },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      ]
    },
    "routeCase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "type", "label", "hash", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "hash": { "$ref": "#/$defs/routeHash" },
        "expect": {
          "type": "object",
          "additionalProperties": true,
          "required": ["route", "type", "id", "params"],
          "properties": {
            "route": { "$ref": "#/$defs/nonEmptyString" },
            "type": { "$ref": "#/$defs/nonEmptyString" },
            "id": { "$ref": "#/$defs/ovsId" },
            "params": { "type": "object" }
          }
        }
      }
    }
  }
}
