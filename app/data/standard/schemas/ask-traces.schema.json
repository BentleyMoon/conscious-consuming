{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/ask-traces-v0.1.schema.json",
  "title": "Open Values Ask Traces v0.1",
  "description": "Deterministic Ask resolver traces for app-owned integration and visual QA.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "built", "source", "purpose", "resolverModel", "traces"],
  "properties": {
    "format": { "const": "ovs-ask-traces" },
    "version": { "$ref": "#/$defs/version" },
    "built": { "$ref": "#/$defs/date" },
    "source": { "$ref": "#/$defs/source" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "resolverModel": { "$ref": "#/$defs/nonEmptyString" },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trace" }
    }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "ovsId": { "type": "string", "pattern": "^ovs:[^\\s/]+/.+$" },
    "routeHash": { "type": "string", "pattern": "^#" },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      ]
    },
    "hit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "type", "route", "hash", "score", "reason", "key"],
      "properties": {
        "id": { "$ref": "#/$defs/ovsId" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "route": { "$ref": "#/$defs/nonEmptyString" },
        "hash": { "$ref": "#/$defs/routeHash" },
        "score": { "type": "number" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "key": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": true,
      "required": ["query", "normalized", "layer", "expectAny", "top", "ok"],
      "properties": {
        "query": { "$ref": "#/$defs/nonEmptyString" },
        "normalized": { "$ref": "#/$defs/nonEmptyString" },
        "layer": { "enum": ["core", "full"] },
        "expectAny": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ovsId" } },
        "orderingAssertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/orderingAssertion" }
        },
        "matched": { "oneOf": [{ "$ref": "#/$defs/ovsId" }, { "type": "null" }] },
        "matchedRank": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "orderingChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/orderingCheck" }
        },
        "ok": { "type": "boolean" },
        "top": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/hit" } }
      }
    },
    "orderingAssertion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "winnerReason", "loserReason"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "winnerReason": { "$ref": "#/$defs/nonEmptyString" },
        "winnerAny": { "type": "array", "items": { "$ref": "#/$defs/ovsId" } },
        "loserReason": { "$ref": "#/$defs/nonEmptyString" },
        "loserAny": { "type": "array", "items": { "$ref": "#/$defs/ovsId" } },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "orderingCheck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "winnerReason", "loserReason", "ok"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "note": { "$ref": "#/$defs/nonEmptyString" },
        "winnerReason": { "$ref": "#/$defs/nonEmptyString" },
        "loserReason": { "$ref": "#/$defs/nonEmptyString" },
        "winnerRank": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "loserRank": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "ok": { "type": "boolean" }
      }
    }
  }
}
