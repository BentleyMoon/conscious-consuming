{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/node-route-guardrails-v0.1.schema.json",
  "title": "Open Values Node Route Guardrails v0.1",
  "description": "Negative and canonicalization route guardrails for app-owned router integration.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "built", "source", "purpose", "appLaneNote", "fallbackGuidance", "cases", "totals"],
  "properties": {
    "format": { "const": "ovs-node-route-guardrails" },
    "version": { "$ref": "#/$defs/version" },
    "built": { "$ref": "#/$defs/date" },
    "source": { "$ref": "#/$defs/source" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "appLaneNote": { "$ref": "#/$defs/nonEmptyString" },
    "fallbackGuidance": { "type": "object", "minProperties": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/guardrailCase" } },
    "totals": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      ]
    },
    "canonicalHash": {
      "oneOf": [
        { "type": "string", "pattern": "^#" },
        { "type": "null" }
      ]
    },
    "guardrailCase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "hash", "reason", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "kind": { "enum": ["malformed", "unsupported", "unknown-target", "canonicalize"] },
        "hash": { "type": "string" },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "expect": {
          "type": "object",
          "additionalProperties": true,
          "required": ["parseable", "targetExists", "canonicalHash"],
          "properties": {
            "parseable": { "type": "boolean" },
            "targetExists": { "type": "boolean" },
            "canonicalHash": { "$ref": "#/$defs/canonicalHash" }
          }
        }
      }
    }
  }
}
