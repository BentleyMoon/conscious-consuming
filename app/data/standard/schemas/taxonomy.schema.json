{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/taxonomy-v1.schema.json",
  "title": "Conscious Consuming Taxonomy v1",
  "description": "The map of every decision the catalogue intends to hold. Four levels, realm to field to family to decision, with six facets crossing the tree and a COICOP 2018 crosswalk used as an outside completeness referee. Distinct from the ontology, which is the navigation of what can be shown today.",
  "type": "object",
  "required": [
    "format",
    "version",
    "levels",
    "facets",
    "coicop",
    "counts",
    "realms"
  ],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "open-values-taxonomy" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "note": { "type": "string" },
    "levels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "job"],
        "properties": {
          "id": { "enum": ["realm", "field", "family", "decision"] },
          "label": { "type": "string", "minLength": 1 },
          "job": { "type": "string", "minLength": 1 }
        }
      }
    },
    "facets": {
      "type": "object",
      "required": ["need", "type", "mode", "cadence", "actor", "scope"],
      "additionalProperties": {
        "type": "object",
        "required": ["values", "job"],
        "properties": {
          "values": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "job": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coicop": {
      "type": "object",
      "description": "The external referee. Every division must be claimed by at least one realm; the audit fails otherwise.",
      "required": ["standard", "publisher", "source", "divisions"],
      "properties": {
        "standard": { "type": "string" },
        "name": { "type": "string" },
        "publisher": { "type": "string" },
        "source": { "type": "string", "format": "uri" },
        "asof": { "type": "string" },
        "divisions": {
          "type": "object",
          "propertyNames": { "pattern": "^\\d{2}$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "counts": {
      "type": "object",
      "description": "Published coverage. Recomputed from the realms by research/taxonomy_audit.js, so the file cannot misreport itself.",
      "required": [
        "realms", "fields", "families", "decisions",
        "inScope", "covered", "open", "hold", "out", "datasets", "coveredPercent"
      ],
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "byNeed": { "type": "object" },
    "byDivision": { "type": "object" },
    "realms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "edge", "coicop", "need", "fields"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "edge": {
            "type": "string",
            "minLength": 40,
            "description": "Where this realm stops and its neighbours begin. Required, because an unbounded realm collects whatever nobody else wanted."
          },
          "coicop": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^(\\d{2}|none)$" }
          },
          "need": { "type": "string" },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "families"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "label": { "type": "string", "minLength": 1 },
                "aka": { "type": "array", "items": { "type": "string" } },
                "coicop": { "type": "array", "items": { "type": "string" } },
                "families": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "decisions"],
                    "properties": {
                      "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                      "label": { "type": "string", "minLength": 1 },
                      "aka": { "type": "array", "items": { "type": "string" } },
                      "decisions": {
                        "type": "array",
                        "minItems": 1,
                        "items": { "$ref": "#/$defs/decision" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "description": "One comparable choice a person faces, and one unit of content work. The id is unique across the whole map, which is what lets parallel agents claim units without collision.",
      "required": ["id", "label", "path", "realm", "field", "family", "need", "type", "mode", "cadence", "actor", "scope"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+/[a-z0-9-]+$" },
        "realm": { "type": "string" },
        "field": { "type": "string" },
        "family": { "type": "string" },
        "need": {
          "enum": ["nourish", "care", "keep-a-home", "connect", "move", "learn", "give-and-act", "protect"]
        },
        "type": { "enum": ["Products", "Services", "Media", "Organizations", "Initiatives"] },
        "mode": {
          "enum": ["buy", "subscribe", "rent", "hire", "borrow", "share", "make", "reuse", "free", "give"],
          "description": "How a person comes to have it. Buying is one of ten, which is the point."
        },
        "cadence": { "enum": ["daily", "weekly", "monthly", "seasonal", "yearly", "rare", "once"] },
        "actor": { "enum": ["person", "household", "community", "organization"] },
        "scope": { "enum": ["covered", "open", "hold", "out"] },
        "cid": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "The built dataset in content/lenses. Present exactly when scope is covered."
        },
        "facet": {
          "type": "string",
          "description": "Set when several decisions share one dataset. Each sharer must name a distinct facet."
        },
        "aka": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": {
          "type": "string",
          "minLength": 24,
          "description": "Required when scope is hold or out. A refusal without a written reason is indistinguishable from an oversight, and the difference is the whole claim to being complete on purpose."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "covered" } }, "required": ["scope"] },
          "then": { "required": ["cid"] }
        },
        {
          "if": { "properties": { "scope": { "const": "open" } }, "required": ["scope"] },
          "then": { "not": { "required": ["cid"] } }
        },
        {
          "if": { "properties": { "scope": { "const": "hold" } }, "required": ["scope"] },
          "then": { "required": ["reason"] }
        },
        {
          "if": { "properties": { "scope": { "const": "out" } }, "required": ["scope"] },
          "then": { "required": ["reason"] }
        }
      ]
    }
  }
}
