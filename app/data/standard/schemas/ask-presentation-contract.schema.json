{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/ask-presentation-contract-v0.1.schema.json",
  "title": "Open Values Ask Presentation Contract v0.1",
  "description": "Suggested presentation contract for app-owned Ask UI integration.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "built", "source", "purpose", "appLaneNote", "resultSections", "typeCopy", "matchReasons", "emptyState", "qaCases"],
  "properties": {
    "format": { "const": "ovs-ask-presentation-contract" },
    "version": { "$ref": "#/$defs/version" },
    "built": { "$ref": "#/$defs/date" },
    "source": { "$ref": "#/$defs/source" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "appLaneNote": { "$ref": "#/$defs/nonEmptyString" },
    "resultSections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resultSection" } },
    "typeCopy": { "type": "object", "minProperties": 1 },
    "matchReasons": { "type": "object", "minProperties": 1 },
    "emptyState": { "$ref": "#/$defs/emptyState" },
    "qaCases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qaCase" } }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "routeHash": { "type": "string", "pattern": "^#" },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      ]
    },
    "resultSection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "layers", "targetTypes", "maxItems"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "layers": { "type": "array", "minItems": 1, "items": { "enum": ["core", "full"] } },
        "targetTypes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "maxItems": { "type": "integer", "minimum": 1 }
      }
    },
    "emptyState": {
      "type": "object",
      "additionalProperties": true,
      "required": ["primary", "secondary"],
      "properties": {
        "primary": { "$ref": "#/$defs/routeHash" },
        "secondary": { "$ref": "#/$defs/routeHash" }
      }
    },
    "qaCase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["query", "section", "expectFirstHash", "expectMatchedHash", "ok"],
      "properties": {
        "query": { "$ref": "#/$defs/nonEmptyString" },
        "section": { "$ref": "#/$defs/nonEmptyString" },
        "expectFirstHash": { "$ref": "#/$defs/routeHash" },
        "expectMatchedHash": { "$ref": "#/$defs/routeHash" },
        "orderingChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/orderingCheck" }
        },
        "ok": { "type": "boolean" }
      }
    },
    "orderingCheck": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "winnerReason", "loserReason", "ok"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "note": { "$ref": "#/$defs/nonEmptyString" },
        "winnerReason": { "$ref": "#/$defs/nonEmptyString" },
        "loserReason": { "$ref": "#/$defs/nonEmptyString" },
        "winnerRank": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "loserRank": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "ok": { "type": "boolean" }
      }
    }
  }
}
