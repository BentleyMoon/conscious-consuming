{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/decision-contracts-v0.2.schema.json",
  "title": "Open Values Decision Contracts v0.2",
  "description": "Signed category reads, practical decision axes, budget-data posture, and computed-answer slots.",
  "type": "object",
  "required": ["format", "version", "published", "status", "consumer", "contracts"],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "open-values-decision-contracts" },
    "version": { "type": "string", "pattern": "^0\\.2\\.0(?:[-+].*)?$" },
    "published": { "type": "string", "format": "date" },
    "status": { "enum": ["founder-signoff-pending", "founder-approved"] },
    "consumer": { "$ref": "#/$defs/consumer" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    }
  },
  "$defs": {
    "consumer": {
      "type": "object",
      "required": ["reads", "axes", "budget", "archetypes"],
      "additionalProperties": false,
      "properties": {
        "reads": { "type": "string", "minLength": 1 },
        "axes": { "type": "string", "minLength": 1 },
        "budget": { "type": "string", "minLength": 1 },
        "archetypes": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object",
      "required": ["category", "reads", "axes", "budget", "archetypes"],
      "additionalProperties": true,
      "properties": {
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "consumer": { "$ref": "#/$defs/consumer" },
        "reads": { "$ref": "#/$defs/reads" },
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/axis" }
        },
        "budget": { "$ref": "#/$defs/budget" },
        "archetypes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["best-for-most", "strictest-match", "budget-honest"]
          }
        }
      }
    },
    "reads": {
      "type": "object",
      "required": ["text", "basis", "signature"],
      "additionalProperties": true,
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 140 },
        "basis": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/readBasis" }
        },
        "signature": { "$ref": "#/$defs/signature" },
        "receipt": { "$ref": "#/$defs/readReceipt" }
      }
    },
    "readBasis": {
      "type": "object",
      "required": ["criterion", "readsAs"],
      "additionalProperties": false,
      "properties": {
        "criterion": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "readsAs": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "required": ["by", "on", "status"],
      "additionalProperties": false,
      "properties": {
        "by": { "type": "string", "minLength": 1 },
        "on": { "type": "string", "format": "date" },
        "status": { "enum": ["pilot", "approved-batch"] }
      }
    },
    "readReceipt": {
      "type": "object",
      "required": ["dataset", "entryCount", "criteria"],
      "additionalProperties": false,
      "properties": {
        "dataset": { "type": "string" },
        "entryCount": { "type": "integer", "minimum": 1 },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/spread" }
        }
      }
    },
    "spread": {
      "type": "object",
      "required": ["criterion", "readsAs", "known", "minimum", "maximum", "spread"],
      "additionalProperties": false,
      "properties": {
        "criterion": { "type": "string" },
        "readsAs": { "type": "string" },
        "known": { "type": "integer", "minimum": 1 },
        "minimum": { "type": "number", "minimum": 0, "maximum": 100 },
        "maximum": { "type": "number", "minimum": 0, "maximum": 100 },
        "spread": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      }
    },
    "axis": {
      "type": "object",
      "required": ["id", "kind", "label", "question", "criteria", "poles", "default"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["criterion", "tradeoff", "cost-values"] },
        "label": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1, "maxLength": 80 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "poles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "default": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "budget": {
      "type": "object",
      "required": ["available", "mode"],
      "additionalProperties": true,
      "properties": {
        "available": { "type": "boolean" },
        "mode": {
          "enum": ["none", "observed-price-rank", "assessed-fees-rank", "assessed-affordability-rank"]
        },
        "criterion": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "minimumKnown": { "type": "integer", "minimum": 1 },
        "knownEntries": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
