{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/door-v0.1.schema.json",
  "title": "Open Values Door v0.1",
  "description": "A well-known discovery document for an Open Values instance and its published lens distributions.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "generatedAt",
    "self",
    "publisher",
    "standard",
    "instance",
    "licenses",
    "privacy",
    "trustArtifacts",
    "stacks",
    "lenses"
  ],
  "properties": {
    "format": {
      "const": "open-values-door"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "self": {
      "$ref": "#/$defs/url"
    },
    "publisher": {
      "$ref": "#/$defs/namedUrl"
    },
    "standard": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "spec": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "role",
        "url",
        "index"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "index": {
          "$ref": "#/$defs/url"
        },
        "cards": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "licenses": {
      "type": "object",
      "additionalProperties": true
    },
    "privacy": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "accounts",
        "tracking",
        "ads",
        "payToRank"
      ],
      "properties": {
        "accounts": {
          "type": "boolean"
        },
        "tracking": {
          "type": "boolean"
        },
        "ads": {
          "type": "boolean"
        },
        "payToRank": {
          "type": "boolean"
        },
        "passportLocation": {
          "type": "string"
        }
      }
    },
    "trustArtifacts": {
      "type": "object",
      "additionalProperties": true
    },
    "stacks": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "index",
        "pattern",
        "hash"
      ],
      "properties": {
        "index": {
          "$ref": "#/$defs/url"
        },
        "pattern": {
          "$ref": "#/$defs/urlTemplate"
        },
        "hash": {
          "const": "sha256"
        }
      }
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lens"
      }
    }
  },
  "$defs": {
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "urlTemplate": {
      "type": "string",
      "pattern": "^https?://"
    },
    "namedUrl": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lens": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "type",
        "domain",
        "entries",
        "criteria",
        "url",
        "data",
        "sha256",
        "integrity",
        "stack",
        "license",
        "source",
        "attribution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "Products",
            "Services",
            "Media",
            "Organizations",
            "Initiatives"
          ]
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "url": {
          "$ref": "#/$defs/urlTemplate"
        },
        "data": {
          "$ref": "#/$defs/url"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha256-[0-9a-f]{64}$"
        },
        "stack": {
          "$ref": "#/$defs/url"
        },
        "license": {
          "$ref": "#/$defs/url"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "asof": {
          "type": "string"
        },
        "sourceAsOf": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
