{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/non-brand-values-v1.schema.json",
  "title": "Open Values Non-Brand Values v1",
  "description": "Values found in a product's brand field that are not a brand, such as a kind of thing, a tier or a route. A builder makes no brand node and no made-by edge from them.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "updated",
    "groups"
  ],
  "properties": {
    "format": {
      "const": "ovs-non-brand-values"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+(?:[-+].*)?$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "groups": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
