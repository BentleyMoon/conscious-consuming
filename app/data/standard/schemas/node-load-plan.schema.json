{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/node-load-plan-v0.1.schema.json",
  "title": "Open Values Node Load Plan v0.1",
  "description": "Runtime loading contract for generated node and Ask files.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "built", "source", "purpose", "appLaneNote", "integrityContract", "budgets", "stages", "totals"],
  "properties": {
    "format": { "const": "ovs-node-load-plan" },
    "version": { "$ref": "#/$defs/version" },
    "built": { "$ref": "#/$defs/date" },
    "source": { "$ref": "#/$defs/source" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "appLaneNote": { "$ref": "#/$defs/nonEmptyString" },
    "integrityContract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["algorithm", "cacheKey", "validate", "retry", "fallback"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "cacheKey": { "$ref": "#/$defs/nonEmptyString" },
        "validate": { "$ref": "#/$defs/nonEmptyString" },
        "retry": { "$ref": "#/$defs/nonEmptyString" },
        "fallback": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "budgets": { "type": "object", "minProperties": 1 },
    "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stage" } },
    "totals": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "label", "loadHint", "files", "trigger", "acceptanceCriteria", "failureMode"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "loadHint": { "$ref": "#/$defs/nonEmptyString" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "trigger": { "$ref": "#/$defs/nonEmptyString" },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "failureMode": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
