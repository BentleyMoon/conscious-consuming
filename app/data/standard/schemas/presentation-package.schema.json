{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/presentation-package-v1.0.schema.json",
  "title": "Open Values Presentation Package v1.0",
  "description": "Generated, implementation-ready taxonomy, public strings, and page-kind contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "built", "consumer", "sources", "taxonomy", "strings", "pageKinds", "fixtures", "sourceIndex", "checksum"],
  "properties": {
    "format": {"const": "open-values-presentation-package"},
    "version": {"const": "1.0.0"},
    "built": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "consumer": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "taxonomy": {
      "type": "object",
      "required": ["source", "sourceSchema", "generatedSource", "version", "levels", "leafState", "counts", "needs", "decisions"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sourceSchema": {"type": "string", "minLength": 1},
        "generatedSource": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "levels": {"type": "array", "minItems": 5},
        "leafState": {"type": "object"},
        "counts": {"type": "object"},
        "needs": {"type": "array", "minItems": 1},
        "decisions": {"type": "array", "minItems": 1}
      }
    },
    "strings": {"type": "object", "minProperties": 1},
    "pageKinds": {"type": "array", "minItems": 10, "maxItems": 10},
    "fixtures": {"type": "array", "minItems": 10, "maxItems": 10},
    "sourceIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "records"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "records": {"type": "array", "minItems": 2}
      }
    },
    "checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
