{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/tag-registry-v0.1.schema.json",
  "title": "Open Values Tag Registry v0.1",
  "description": "Canonical tag labels, aliases, kinds, readable meanings, and optional receipt links.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "updated",
    "minItems",
    "tags"
  ],
  "properties": {
    "format": {
      "const": "ovs-tag-registry"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "minItems": {
      "type": "integer",
      "minimum": 1
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tag"
      }
    }
  },
  "$defs": {
    "tag": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "label",
        "aliases",
        "kind",
        "reads",
        "receipt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ovs:tag/[a-z0-9-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "kind": {
          "enum": [
            "property",
            "certification",
            "topic"
          ]
        },
        "reads": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
