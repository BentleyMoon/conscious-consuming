{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/proposal-v0.1.schema.json",
  "title": "Open Values Proposal v0.1",
  "description": "A portable governance patch: target, base hash, rationale, author, operations, and signature metadata.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "id", "status", "target", "author", "created", "updated", "rationale", "operations", "signature"],
  "properties": {
    "format": { "const": "open-values-proposal" },
    "version": { "type": "string", "pattern": "^0\\.1\\.0(?:[-+].*)?$" },
    "id": { "$ref": "#/$defs/slug" },
    "status": { "enum": ["template", "draft", "submitted", "withdrawn", "superseded", "archived"] },
    "target": { "$ref": "#/$defs/target" },
    "author": { "$ref": "#/$defs/actor" },
    "created": { "$ref": "#/$defs/date" },
    "updated": { "$ref": "#/$defs/date" },
    "rationale": { "$ref": "#/$defs/nonEmptyString" },
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } },
    "signature": { "$ref": "#/$defs/signature" },
    "limits": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "shortHash": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": ["path", "format", "baseSha256", "baseHash"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "format": { "type": "string", "pattern": "^(open-values|ovs)-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "baseSha256": { "$ref": "#/$defs/sha256" },
        "baseHash": { "$ref": "#/$defs/shortHash" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "id", "display"],
      "properties": {
        "type": { "$ref": "#/$defs/nonEmptyString" },
        "id": { "$ref": "#/$defs/slug" },
        "display": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["op", "path", "summary", "impact", "risk"],
      "properties": {
        "op": { "enum": ["add-item", "remove-item", "edit-field", "set-field", "note"] },
        "path": { "type": "string", "pattern": "^/" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "impact": { "$ref": "#/$defs/nonEmptyString" },
        "risk": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": true,
      "required": ["method", "verified"],
      "properties": {
        "method": { "$ref": "#/$defs/nonEmptyString" },
        "verified": { "type": "boolean" }
      }
    }
  }
}
