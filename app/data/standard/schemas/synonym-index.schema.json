{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/synonym-index-v0.1.schema.json",
  "title": "Open Values Synonym Index v0.1",
  "description": "A generated lookup index from aliases and normalized aliases to Open Values category or tag targets.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "built",
    "source",
    "aliases",
    "normalized",
    "targets"
  ],
  "properties": {
    "format": {
      "const": "ovs-synonym-index"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "built": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "$ref": "#/$defs/targetMap"
    },
    "normalized": {
      "$ref": "#/$defs/targetMap"
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "string",
      "pattern": "^ovs:(cat|tag)/[a-z0-9-]+$"
    },
    "targetMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/target"
      }
    }
  }
}
