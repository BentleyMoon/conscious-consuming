{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/register-snapshot-v1.schema.json",
  "title": "Open Values Register Snapshot",
  "description": "A reproducible receipt for raw bytes captured from one public register request.",
  "type": "object",
  "required": ["format", "version", "snapshotId", "registerId", "access", "capturedAt", "request", "response", "license", "parser"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "open-values-register-snapshot" },
    "version": { "const": "1.0.0" },
    "snapshotId": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{12}$" },
    "registerId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "access": { "enum": ["api", "bulk", "page"] },
    "capturedAt": { "type": "string", "format": "date-time" },
    "request": {
      "type": "object",
      "required": ["method", "url", "query", "scope", "headers", "secretHeaderNames"],
      "additionalProperties": false,
      "properties": {
        "method": { "const": "GET" },
        "url": { "type": "string", "pattern": "^https?://" },
        "query": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "scope": { "type": "string", "minLength": 1 },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "secretHeaderNames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["Authorization", "Cookie", "Proxy-Authorization", "X-Api-Key", "Api-Key"] }
        }
      }
    },
    "response": {
      "type": "object",
      "required": ["status", "finalUrl", "mediaType", "bytes", "sha256", "payload", "fetchMode"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer", "minimum": 200, "maximum": 299 },
        "finalUrl": { "type": "string", "pattern": "^https?://" },
        "mediaType": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "payload": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-[0-9a-f]{12}\\.payload\\.[a-z0-9]{1,10}$" },
        "fetchMode": { "enum": ["network", "file-import"] }
      }
    },
    "license": {
      "type": "object",
      "required": ["url", "note"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "parser": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" }
      }
    }
  }
}
