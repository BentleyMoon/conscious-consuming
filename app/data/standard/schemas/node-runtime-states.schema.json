{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/node-runtime-states-v0.1.schema.json",
  "title": "Open Values Node Runtime States v0.1",
  "description": "Runtime state and failure-mode fixtures for generated node and Ask integration.",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "built", "source", "purpose", "appLaneNote", "caseFields", "qaContract", "cases", "totals"],
  "properties": {
    "format": { "const": "ovs-node-runtime-states" },
    "version": { "$ref": "#/$defs/version" },
    "built": { "$ref": "#/$defs/date" },
    "source": { "$ref": "#/$defs/source" },
    "purpose": { "$ref": "#/$defs/nonEmptyString" },
    "appLaneNote": { "$ref": "#/$defs/nonEmptyString" },
    "caseFields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
    "qaContract": { "$ref": "#/$defs/qaContract" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stateCase" } },
    "totals": { "type": "object", "minProperties": 1 }
  },
  "$defs": {
    "version": { "type": "string", "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "source": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      ]
    },
    "stateCase": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "family", "stage", "trigger", "requiredBehavior", "mustNot", "appOwnedCopyIntent", "sourceFiles"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "family": { "$ref": "#/$defs/nonEmptyString" },
        "stage": { "$ref": "#/$defs/nonEmptyString" },
        "trigger": { "$ref": "#/$defs/nonEmptyString" },
        "requiredBehavior": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "mustNot": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "appOwnedCopyIntent": { "$ref": "#/$defs/nonEmptyString" },
        "sourceFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "qaContract": {
      "type": "object",
      "additionalProperties": true,
      "required": ["purpose", "status", "h4DrainableFromDataAlone", "drainRule", "modes", "loadStageCoverage", "coverage"],
      "properties": {
        "purpose": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "const": "pending-app-integration" },
        "h4DrainableFromDataAlone": { "const": false },
        "drainRule": { "$ref": "#/$defs/nonEmptyString" },
        "modes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/qaMode" } },
        "loadStageCoverage": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/loadStageCoverage" }
        },
        "coverage": { "type": "object", "minProperties": 1 }
      }
    },
    "qaMode": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "owner", "caseIds", "sourceFiles", "passWhen", "mustNot"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "owner": { "const": "app/design" },
        "caseIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "sourceFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "passWhen": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "mustNot": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "loadStageCoverage": {
      "type": "object",
      "additionalProperties": true,
      "required": ["loadHint", "runtime", "sourceFiles", "caseIds"],
      "properties": {
        "loadHint": { "$ref": "#/$defs/nonEmptyString" },
        "runtime": { "type": "boolean" },
        "sourceFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "caseIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
      }
    }
  }
}
