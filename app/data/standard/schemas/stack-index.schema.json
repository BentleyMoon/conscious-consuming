{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/stack-index-v0.1.schema.json",
  "title": "Open Values Stack Index v0.1",
  "description": "A content-addressed index of published lens snapshots.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "generatedAt",
    "sourceDoor",
    "hash",
    "description",
    "lenses"
  ],
  "properties": {
    "format": {
      "const": "open-values-stack-index"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "sourceDoor": {
      "type": "string",
      "pattern": "^https?://"
    },
    "hash": {
      "const": "sha256"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "lenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lens"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lens": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "sha256",
        "integrity",
        "path",
        "url",
        "canonicalData",
        "license"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha256-[0-9a-f]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^/stacks/lens/[a-z0-9]+(?:-[a-z0-9]+)*/[0-9a-f]{64}\\.json$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "canonicalData": {
          "type": "string",
          "pattern": "^https?://"
        },
        "license": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    }
  }
}
