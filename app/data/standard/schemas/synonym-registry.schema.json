{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvaluesstandard.org/schema/synonym-registry-v0.1.schema.json",
  "title": "Open Values Synonym Registry v0.1",
  "description": "Search aliases that normalize ordinary user language into known category or tag targets.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "format",
    "version",
    "updated",
    "synonyms"
  ],
  "properties": {
    "format": {
      "const": "ovs-synonym-registry"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1(?:\\.0)?(?:[-+].*)?$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "synonyms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^ovs:(cat|tag)/[a-z0-9-]+$"
      }
    }
  }
}
