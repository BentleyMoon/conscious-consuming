{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuescommons.org/schema/cc-work-lock-v1.schema.json",
  "title": "Conscious Consuming retained work lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "version", "fingerprint", "capsuleId", "scope", "events"],
  "properties": {
    "kind": {"const": "cc-work-lock"},
    "version": {"const": "1.0.0"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "capsuleId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "owner", "at", "expiresAt", "note"],
        "properties": {
          "action": {"enum": ["acquired", "released"]},
          "owner": {"type": "string", "minLength": 1},
          "at": {"type": "string", "format": "date-time"},
          "expiresAt": {"type": ["string", "null"], "format": "date-time"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
