{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuescommons.org/schema/cc-adoption-event-v1.schema.json",
  "title": "Conscious Consuming external adoption event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "id",
    "gateId",
    "eventType",
    "subjectKey",
    "externalActorClass",
    "occurredAt",
    "recordedAt",
    "summary",
    "evidence",
    "review",
    "privacy",
    "claimBoundary"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "kind": {"const": "cc-adoption-event"},
    "version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "gateId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "eventType": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "subjectKey": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "externalActorClass": {
      "enum": ["external-person", "external-group", "external-agent", "external-builder", "external-researcher"]
    },
    "occurredAt": {"type": "string", "format": "date-time"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 240},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "observedAt", "note"],
        "properties": {
          "kind": {"enum": ["public-url", "private-receipt-id", "operator-observation", "external-message-id"]},
          "reference": {
            "type": "string",
            "pattern": "^(https://|receipt:|observation:|message:)[^\\s@]+$"
          },
          "observedAt": {"type": "string", "format": "date-time"},
          "note": {"type": "string", "minLength": 1, "maxLength": 240}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rationale"],
      "properties": {
        "status": {"enum": ["pending", "confirmed", "rejected"]},
        "reviewerRole": {"enum": ["founder", "release-owner"]},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 240}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "confirmed"}}},
          "then": {"required": ["reviewerRole", "reviewedAt"]}
        }
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsContactDetails", "containsPrivateValues", "redactionsApplied", "note"],
      "properties": {
        "containsContactDetails": {"const": false},
        "containsPrivateValues": {"const": false},
        "redactionsApplied": {"type": "boolean"},
        "note": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "doesNotSupport"],
      "properties": {
        "supports": {"type": "string", "minLength": 1, "maxLength": 240},
        "doesNotSupport": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    }
  }
}
