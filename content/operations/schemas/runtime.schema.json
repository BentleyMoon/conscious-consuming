{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuescommons.org/schema/cc-agentic-content-runtime-v1.schema.json",
  "title": "Conscious Consuming agentic content runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "model",
    "sourcesOfTruth",
    "queue",
    "workInProgressLimit",
    "maxParallelReadOnlyScouts",
    "states",
    "activeStates",
    "terminalStates",
    "workModes",
    "verdicts",
    "failureRoutes",
    "requiredBuildCommands"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "kind": {"const": "cc-agentic-content-runtime"},
    "version": {"const": "1.0.0"},
    "model": {"$ref": "#/$defs/model"},
    "sourcesOfTruth": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
    "queue": {"$ref": "#/$defs/nonEmptyString"},
    "workInProgressLimit": {"const": 1},
    "maxParallelReadOnlyScouts": {"type": "integer", "minimum": 1, "maximum": 3},
    "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
    "activeStates": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
    "terminalStates": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
    "workModes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
    "verdicts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}, "uniqueItems": true},
    "failureRoutes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/failureRoute"}},
    "requiredBuildCommands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reasoningEffort"],
      "properties": {
        "id": {"const": "gpt-5.6-sol"},
        "reasoningEffort": {"const": "medium"}
      }
    },
    "failureRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "hardStop", "why"],
      "properties": {
        "action": {"$ref": "#/$defs/nonEmptyString"},
        "hardStop": {"type": "boolean"},
        "why": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
