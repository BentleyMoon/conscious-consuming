{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuescommons.org/schema/cc-work-ledger-entry-v1.schema.json",
  "title": "Conscious Consuming append-only work-ledger entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "fingerprint",
    "capsuleId",
    "recordedAt",
    "state",
    "verdict",
    "headline",
    "workMode",
    "decision",
    "liveConsumer",
    "model",
    "artifacts",
    "verification",
    "git",
    "failureClass",
    "followup"
  ],
  "properties": {
    "kind": {"const": "cc-work-ledger-entry"},
    "version": {"const": "1.0.0"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "capsuleId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "state": {"enum": ["COMPLETE", "BLOCKED", "KILLED", "SUPERSEDED"]},
    "verdict": {"enum": ["POSITIVE", "NEGATIVE", "MIXED", "BLOCKED", "KILLED"]},
    "headline": {"type": "string", "minLength": 1},
    "workMode": {"type": "string", "minLength": 1},
    "decision": {"type": "string", "minLength": 1},
    "liveConsumer": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reasoningEffort"],
      "properties": {
        "id": {"const": "gpt-5.6-sol"},
        "reasoningEffort": {"const": "medium"}
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "commit"],
      "properties": {
        "branch": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
      }
    },
    "failureClass": {"type": ["string", "null"]},
    "followup": {"type": "string"}
  }
}
