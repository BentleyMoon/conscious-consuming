  "valueBloom": {
    "status": "h4-token-substrate",
    "consumer": "Claude H4 values-bloom verdict card prototype",
    "sourceFunction": "CC.engine.signature(entity, key2theme)",
    "minimumThemesForBloom": 2,
    "scoreScale": "0..100 mean score per carried theme; omitted themes stay absent, never zero-filled",
    "order": ["planet", "people", "health", "honesty", "privacy", "animals", "cost", "local"],
    "themes": [
      { "id": "planet", "label": "Planet", "universal": "planet", "petalColor": "#3F8F5E", "centerColor": "#2F6F4E", "role": "leaf green for environment, waste, durability" },
      { "id": "people", "label": "People", "universal": "people", "petalColor": "#C07A53", "centerColor": "#8F4F31", "role": "clay for labor, ethics, public benefit" },
      { "id": "health", "label": "Health", "universal": "wellbeing", "petalColor": "#C86D6A", "centerColor": "#884640", "role": "rose clay for nutrition, safety, low-tox care" },
      { "id": "honesty", "label": "Honesty", "universal": "openness", "petalColor": "#C2A049", "centerColor": "#7C621F", "role": "seed ochre for transparency and independence" },
      { "id": "privacy", "label": "Privacy", "universal": "autonomy", "petalColor": "#4F8FA9", "centerColor": "#2D6075", "role": "water blue for data control, security, openness" },
      { "id": "animals", "label": "Animals", "universal": "animals", "petalColor": "#8A7FB5", "centerColor": "#5E5484", "role": "violet for animal welfare without alarm" },
      { "id": "cost", "label": "Cost & ease", "universal": "access", "petalColor": "#6FA07A", "centerColor": "#477451", "role": "sage for affordability, fees, ease" },
      { "id": "local", "label": "Local", "universal": "community", "petalColor": "#B0894F", "centerColor": "#73582D", "role": "warm bark for community, co-ops, ownership" }
    ],
    "signatureVector": {
      "status": "optional-materialization-contract",
      "field": "valueSignature",
      "order": ["planet", "people", "health", "honesty", "privacy", "animals", "cost", "local"],
      "shape": "object keyed by carried theme id; numeric values are 0..100 means from scored criteria",
      "omitMissing": true,
      "mustNot": [
        "Do not store absent themes as 0.",
        "Do not draw a bloom when fewer than two themes resolve.",
        "Do not use the bloom as evidence; it is a visual summary of already-rendered scores."
      ]
    }
  },
