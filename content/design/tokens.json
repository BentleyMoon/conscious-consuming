  "contrastRemediationContract": {
    "status": "h9-app-owned-remediation",
    "consumer": "Claude H9 contrast cleanup in app/styles.css",
    "sourceAudit": "research/contrast_audit.js",
    "appOwnedFile": "app/styles.css",
    "rule": "Use this as an app-owned remediation checklist; Codex supplies tokens and warnings but does not edit app CSS.",
    "steps": [
      {
        "id": "wire-accent-text-token",
        "label": "Wire --accent-text on accent action surfaces",
        "warning": "dark white on accent action contrast 2.01 is below 4.5",
        "theme": "dark",
        "foreground": "#fff",
        "background": "--accent",
        "ratio": 2.01,
        "minimum": 4.5,
        "targetCssVariables": ["--accent-text", "--accent"],
        "tokenSource": "color.accentText",
        "appOwnedEvidence": [
          "Dark-theme accent buttons and action surfaces use --accent-text rather than literal #fff.",
          "npm run audit:contrast no longer reports dark white on accent action."
        ],
        "mustNot": [
          "Do not keep literal #fff text on the light green dark-theme accent.",
          "Do not solve this by lowering the 4.5 contrast floor."
        ]
      },
      {
        "id": "light-hint-on-pill",
        "label": "Move tiny hint-on-pill text to a stronger foreground",
        "warning": "light hint on pill contrast 4.28 is below 4.5",
        "theme": "light",
        "foreground": "--hint",
        "background": "--pill",
        "ratio": 4.28,
        "minimum": 4.5,
        "targetCssVariables": ["--hint", "--pill", "--muted", "--ink"],
        "tokenSource": "color.mutedText",
        "appOwnedEvidence": [
          "Small text on pill fills uses a darker foreground such as --muted or --ink, or the app token pair is adjusted.",
          "npm run audit:contrast no longer reports light hint on pill."
        ],
        "mustNot": [
          "Do not leave sub-AA small hint text on pill surfaces.",
          "Do not make pills visually louder just to avoid changing the foreground."
        ]
      },
      {
        "id": "light-hint-on-track",
        "label": "Move tiny hint-on-track text to a stronger foreground",
        "warning": "light hint on track contrast 3.97 is below 4.5",
        "theme": "light",
        "foreground": "--hint",
        "background": "--track",
        "ratio": 3.97,
        "minimum": 4.5,
        "targetCssVariables": ["--hint", "--track", "--muted", "--ink"],
        "tokenSource": "color.mutedText",
        "appOwnedEvidence": [
          "Small text on track badges uses a darker foreground such as --muted or --ink, or the app token pair is adjusted.",
          "npm run audit:contrast no longer reports light hint on track."
        ],
        "mustNot": [
          "Do not keep low-contrast helper text on track badges.",
          "Do not hide the text to avoid the contrast decision."
        ]
      },
      {
        "id": "light-muted-on-track",
        "label": "Raise muted-on-track contrast above the edge",
        "warning": "light muted on track contrast 4.48 is below 4.5",
        "theme": "light",
        "foreground": "--muted",
        "background": "--track",
        "ratio": 4.48,
        "minimum": 4.5,
        "targetCssVariables": ["--muted", "--track", "--ink"],
        "tokenSource": "color.mutedText",
        "appOwnedEvidence": [
          "Muted text on track surfaces either crosses AA or uses --ink where the text is small.",
          "npm run audit:contrast no longer reports light muted on track."
        ],
        "mustNot": [
          "Do not accept an edge-case 4.48 pair as passing for normal text.",
          "Do not rely on font weight or size changes without verifying the actual text use."
        ]
      },
      {
        "id": "light-accent-on-track",
        "label": "Avoid accent-as-small-text on track fills",
        "warning": "light accent on track contrast 4.34 is below 4.5",
        "theme": "light",
        "foreground": "--accent",
        "background": "--track",
        "ratio": 4.34,
        "minimum": 4.5,
        "targetCssVariables": ["--accent", "--track", "--ink", "--link"],
        "tokenSource": "color.accent",
        "appOwnedEvidence": [
          "Accent text on track fills is replaced with a passing text token or the pair is adjusted.",
          "npm run audit:contrast no longer reports light accent on track."
        ],
        "mustNot": [
          "Do not use color alone to carry action or status meaning.",
          "Do not make track surfaces darker without checking every other track text pair."
        ]
      }
    ],
    "sharedEvidenceRequired": [
      "Run npm run audit:contrast after the app CSS change.",
      "Keep icon-only labels and focus-visible coverage green while changing the color pairs.",
      "Leave the design-token source as data unless app/design explicitly chooses a new token source."
    ],
    "coverage": {
      "warnings": 5,
      "steps": 5,
      "requiredCssVariable": "--accent-text",
      "appOwned": true,
      "dataOnlyFix": false
    }
  },
